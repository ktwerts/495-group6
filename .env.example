# Copy to .env (never commit .env) or set these in your shell.

# development | testing | production
SHIFTWISE_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SHIFTWISE_SECRET_KEY=

# Password for the `manager` account created by `flask seed`.
# Leave blank to have one generated and printed.
SHIFTWISE_ADMIN_PASSWORD=

# Optional overrides (defaults live in the instance/ folder)
# SHIFTWISE_DATABASE=instance/shiftwise.sqlite
# SHIFTWISE_MODEL_PATH=instance/staffing_model.joblib
# SHIFTWISE_FORECAST_MIN_HISTORY=28
